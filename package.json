    "marked": "16.4.2",
    "mermaid": "11.17.2"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^22.18.0",
    "jsdom": "^26.1.0",
    "typescript": "~5.9.3",
    "vite": "^8.2.2"
  },
  "description": "A browser-based Mermaid viewer with structured layouts, traceable connections, and local-only diagram editing.",
  "homepage": "https://paul.mou.dev/mermaid-studio/",
  "repository": {
    "type": "git",
    "url": "https://github.com/moomou/mermaid-studio.git"
  },
  "engines": {
    "node": ">=22.18.0"
  }
