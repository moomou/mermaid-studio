{
  "name": "mermaid-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --experimental-strip-types --test --test-concurrency=1 tests/*.test.ts"
  },
  "dependencies": {
    "elkjs": "0.12.0",
